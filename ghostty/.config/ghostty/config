font-size = 16

# Keybinds
# ref: https://ghostty.org/docs/config/keybind

# use ctrl + ` as leader
# ref: https://ghostty.org/docs/config/keybind/sequence

# windows
keybind = ctrl+grave_accent>n=new_window
keybind = ctrl+grave_accent>t=new_tab

# splits
keybind = ctrl+grave_accent>\=new_split:right
keybind = ctrl+grave_accent>minus=new_split:down

# splits: resizing
keybind = ctrl+grave_accent>equal=equalize_splits
keybind = ctrl+grave_accent>shift+up=resize_split:up,10
keybind = ctrl+grave_accent>shift+down=resize_split:down,10
keybind = ctrl+grave_accent>shift+right=resize_split:right,10
keybind = ctrl+grave_accent>shift+left=resize_split:left,10

# splits: navigation
keybind = ctrl+grave_accent>left_bracket=goto_split:previous
keybind = ctrl+grave_accent>right_bracket=goto_split:next
keybind = ctrl+grave_accent>up=goto_split:up
keybind = ctrl+grave_accent>down=goto_split:down
keybind = ctrl+grave_accent>right=goto_split:right
keybind = ctrl+grave_accent>left=goto_split:left

# tabs: navigation
keybind = ctrl+grave_accent>one=goto_tab:1
keybind = ctrl+grave_accent>two=goto_tab:2
keybind = ctrl+grave_accent>three=goto_tab:3
keybind = ctrl+grave_accent>four=goto_tab:4
keybind = ctrl+grave_accent>five=goto_tab:5
keybind = ctrl+grave_accent>six=goto_tab:6
keybind = ctrl+grave_accent>seven=goto_tab:7
keybind = ctrl+grave_accent>eight=goto_tab:8
keybind = ctrl+grave_accent>nine=last_tab

# clipboard / selection
keybind = ctrl+grave_accent>a=select_all
keybind = ctrl+grave_accent>y=copy_to_clipboard
keybind = ctrl+grave_accent>p=paste_from_clipboard

# screen
keybind = ctrl+grave_accent>comma=reload_config
keybind = ctrl+grave_accent>r=reset
keybind = ctrl+grave_accent>l=clear_screen

# backspace niceties
keybind = alt+delete=esc:d
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = super+backspace=text:\x15
keybind = super+delete=text:\x0b
keybind = super+left=text:\x01
keybind = super+right=text:\x05
