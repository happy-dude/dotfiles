{
  "coc.preferences.formatOnSaveFiletypes": [
    "c",
    "clojure",
    "cpp",
    "css",
    "fish",
    "go",
    "gomod",
    "html",
    "javascript",
    "javascriptreact",
    "json",
    "lua",
    "markdown",
    "perl",
    "plaintex",
    "python",
    "ruby",
    "rust",
    "sh",
    "sql",
    "terraform",
    "tex",
    "typescript",
    "typescriptreact",
    "typst",
    "yaml",
    "zig"
  ],
  "clangd.checkUpdates": false,
  "clangd.path": "clangd",
  "rust-analyzer.server.path": "rust-analyzer",
  "rust-analyzer.updates.checkOnStartup": false,
  "rust-analyzer.updates.prompt": false,
  "diagnostic.checkCurrentLine": true,
  "diagnostic.errorSign": ">>",
  "diagnostic.refreshAfterSave": true,
  "diagnostic.warningSign": "--",
  "inlayHint.enableParameter": false,
  "git.addedSign.text": "++",
  "git.branchCharacter": ".\ue0a0",
  "git.changeRemovedSign.text": "\u2243\u2243",
  "git.changedDecorator": "**",
  "git.changedSign.text": "~~",
  "git.conflictedDecorator": "xx",
  "git.removedSign.text": "__",
  "git.stagedDecorator": "\u25cf\u25cf",
  "git.topRemovedSign.text": "\u203e\u203e",
  "git.untrackedDecorator": "\u2026\u2026",
  "zuban.path": "zuban",
  "languageserver": {
    "bash-language-server": {
      "command": "bash-language-server",
      "args": ["start"],
      "filetypes": ["sh"]
    },
    "fish-lsp": {
      "command": "fish-lsp",
      "args": ["start"],
      "filetypes": ["fish"]
    },
    "clojure-lsp": {
      "command": "clojure-lsp",
      "args": ["listen"],
      "filetypes": ["clojure"],
      "rootPatterns": [
        "deps.edn",
        "bb.edn",
        "shadow-cljs.edn",
        "project.clj",
        "build.boot",
        ".git"
      ]
    },
    "fennel-ls": {
      "command": "fennel-ls",
      "args": ["--server"],
      "filetypes": ["fennel"],
      "rootPatterns": ["flsproject.fnl", ".git"]
    },
    "texlab": {
      "command": "texlab",
      "filetypes": ["tex", "plaintex"],
      "rootPatterns": [".latexmkrc", "latexmkrc", ".git"]
    },
    "tinymist": {
      "command": "tinymist",
      "args": ["lsp"],
      "filetypes": ["typst"],
      "rootPatterns": ["typst.toml", ".git"]
    },
    "json-language-server": {
      "command": "vscode-json-language-server",
      "args": ["--stdio"],
      "filetypes": ["json", "jsonc"]
    },
    "marksman": {
      "command": "marksman",
      "args": ["server"],
      "filetypes": ["markdown"],
      "rootPatterns": [".marksman.toml", ".git"]
    },
    "golang": {
      "command": "gopls",
      "filetypes": ["go", "gomod", "gowork", "gotmpl"],
      "rootPatterns": ["go.work", "go.mod", ".git"]
    },
    "typescript-language-server": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "filetypes": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
      ],
      "rootPatterns": ["package.json", "tsconfig.json", "jsconfig.json", ".git"]
    },
    "ruff": {
      "command": "ruff",
      "args": ["server"],
      "filetypes": ["python"],
      "rootPatterns": ["pyproject.toml", "ruff.toml", ".ruff.toml", ".git"],
      "disabledFeatures": ["hover"]
    },
    "lua-language-server": {
      "command": "lua-language-server",
      "filetypes": ["lua"],
      "rootPatterns": [".luarc.json", ".luarc.jsonc", ".git"]
    },
    "perl-navigator": {
      "command": "perlnavigator",
      "args": ["--stdio"],
      "filetypes": ["perl"]
    },
    "perl-language-server": {
      "command": "perl",
      "args": ["-MPerl::LanguageServer", "-e", "Perl::LanguageServer::run"],
      "filetypes": ["perl"],
      "disabledFeatures": [
        "completion",
        "diagnostics",
        "hover",
        "definition",
        "documentSymbol",
        "workspaceSymbol",
        "formatting",
        "documentFormatting",
        "documentRangeFormatting"
      ]
    },
    "zls": {
      "command": "zls",
      "filetypes": ["zig"],
      "rootPatterns": ["build.zig", "build.zig.zon", ".git"]
    },
    "vim-language-server": {
      "command": "vim-language-server",
      "args": ["--stdio"],
      "filetypes": ["vim"]
    }
  },
  "markdownlint.onChange": false,
  "markdownlint.onOpen": false,
  "markdownlint.onSave": true,
  "sumneko-lua.enable": false,
  "Lua.telemetry.enable": false,
  "workspace.ignoredFolders": ["$HOME", "$HOME/.cargo/**", "$HOME/.rustup/**"],
  "suggest.autoTrigger": "always",
  "coc.source.around.filetypes": ["codecompanion"],
  "coc.source.buffer.filetypes": ["codecompanion"],
  "coc.source.file.filetypes": ["codecompanion"]
}
