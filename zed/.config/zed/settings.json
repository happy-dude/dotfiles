{
    "base_keymap": "Emacs",
    "buffer_font_family": "FantasqueSansM Nerd Font Mono",
    "buffer_font_size": 14.0,
    "buffer_line_height": "comfortable",
    "icon_theme": "Zed (Default)",
    "project_panel": {
        "dock": "left"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "terminal": {
        "shell": {
            "program": "fish"
        }
    },
    "theme": {
        "dark": "Gruvbox Dark",
        "light": "Gruvbox Light",
        "mode": "dark"
    },
    "title_bar": {
        "show_branch_status_icon": true,
        "show_menus": true
    },
    "ui_font_family": "Noto Sans",
    "ui_font_size": 16,
    "vim_mode": true
}
