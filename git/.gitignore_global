# # -*- mode: gitignore; -*-
# Author: Stanley Chan
# Github: https://github.com/Happy-Dude
# Deployed by Home Manager as ~/.config/git/ignore, which Git reads without
# any core.excludesFile setting. Patterns here apply to every repository, so
# they must only ever match generated or machine-local files.

# Ignore documentation tags generated by vim plugins/submodules
*.netrwhist
*.roswell/
*.vscode
*accounts.conf
*doc/tags
*vim/.vim/spell
*vim/shada
*~

# Ignore xmonad compiled files and executables
*.hi
*.errors
xmonad-x86*

# emacs
*emacs/.config/emacs/.org-id-locations
*emacs/.config/emacs/bookmarks
*emacs/.config/emacs/eln-cache/
*emacs/.config/emacs/elpa/
*emacs/.config/emacs/transient
*.elc
*org-roam.db

# Recommended rules from https://help.github.com/articles/ignoring-files
# Compiled source #
###################
#*.com
*.class
*.dll
*.exe
*.o
*.so
*.pyc

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

rime/.local/share/fcitx5/rime/*.userdb/

# Sync directory (machine-specific)
rime/.local/share/fcitx5/rime/sync/

# Build output (regenerated on deploy)
rime/.local/share/fcitx5/rime/build/

# Runtime state files
rime/.local/share/fcitx5/rime/user.yaml
rime/.local/share/fcitx5/rime/installation.yaml

# Trash/temp
rime/.local/share/fcitx5/rime/trash/

# Nix build outputs
result
result-*

# direnv
.direnv/

# Claude Code project session state written into a repo when run there
# (root-anchored so it does NOT match the tracked claude/.claude/agents/)
/.claude/

# Per-machine git identity/signing — real file lives at ~/.config/git/local.config
local.config
