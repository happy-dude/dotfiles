# # -*- mode: gitignore; -*-
# Author: Stanley Chan
# Github: https://github.com/Happy-Dude
# Deployed by Home Manager as ~/.config/git/ignore, which Git reads without
# any core.excludesFile setting. Patterns here apply to every repository, so
# they name only object and bytecode files, OS litter, and editor state; a
# pattern that can match a tracked file belongs in that project's .gitignore.

# Editor and shell litter
*.vscode
*~

# Ignore xmonad compiled files and executables
*.hi
*.errors
xmonad-x86*

# emacs
*.elc
*org-roam.db

# Recommended rules from https://help.github.com/articles/ignoring-files
# Compiled source #
###################
#*.com
*.class
*.o
*.pyc

# Logs and databases #
######################

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Nix build outputs at a repository's top level
/result
/result-*

# direnv
.direnv/

# Claude Code project session state written into a repo when run there
# (root-anchored so a project's own nested .claude/ directories stay visible)
/.claude/

